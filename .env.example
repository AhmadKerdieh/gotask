# Copy to .env and adjust. .env is gitignored.

# ── Application ──────────────────────────────────────────────────────────
ENV=development             # development | staging | production | test
PORT=8080
LOG_LEVEL=info              # debug | info | warn | error
STATIC_DIR=./static

# ── HTTP layer (Phase 1) ─────────────────────────────────────────────────

# Strict CORS allowlist. Comma-separated, no spaces required around commas.
# In production, list ONLY the origins of your real frontend(s).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Per-request deadline applied by the timeout middleware.
# Any format time.ParseDuration accepts: "200ms", "15s", "1m".
REQUEST_TIMEOUT=15s

# ── Domain (Phase 2) ─────────────────────────────────────────────────────

# Path to the workflow definition file. The application loads this once
# at startup; the values inside determine the legal statuses, transitions,
# and priorities. In production set to an absolute path and ship the file
# alongside the binary.
WORKFLOW_PATH=./workflow.yaml

# ── Database (Phase 3) ───────────────────────────────────────────────────

# libpq-style Postgres connection string. THERE IS NO DEFAULT — the app
# refuses to start without this, because running without a database is
# never correct. The value below matches docker/docker-compose.yml.
#
# sslmode=disable is fine for local docker; in production use
# sslmode=require (or verify-full) against a TLS-terminated database.
DATABASE_URL=postgres://gotask:gotask@localhost:5432/gotask?sslmode=disable

# Connection pool sizing. Postgres has a global max_connections budget
# (default 100) shared by every client, so a single service should claim
# a known, bounded slice. DB_MIN_CONNS keeps a few connections warm so the
# first request after an idle period does not pay full connect latency.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ── OIDC / Keycloak (Phase 6) ────────────────────────────────────────────

# The Keycloak realm issuer URL. The app does OIDC discovery against
# <issuer>/.well-known/openid-configuration at startup to find the JWKS
# endpoint — it never hardcodes key URLs. Must match KC_HOSTNAME_URL +
# /realms/<realm> from docker-compose. Keycloak must be running and the
# realm imported before the app starts (make kc-up waits for this).
OIDC_ISSUER=http://localhost:8081/realms/gotask

# This app's client id as registered in the realm (see realm-export.json).
# Every token's aud claim MUST include this — that check stops a token
# minted for a different client being replayed against us. No client
# secret: the only OAuth client is the browser SPA, a PUBLIC client using
# PKCE.
OIDC_CLIENT_ID=gotask-spa

# ── Keycloak Admin API (Phase 7) ─────────────────────────────────────────
# Optional. When set, audit responses enrich the actor with name/email
# from Keycloak via the Admin API (because Option A means there is no
# local users table to JOIN). Leave the client id/secret blank and the
# app uses a noop lookup — audit responses still work, just without names.
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=gotask
KEYCLOAK_ADMIN_CLIENT_ID=gotask-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=gotask-backend-secret

# ── Phase 8: concurrency & lifecycle ────────────────────────────────────
# How often the audit drainer polls for outbox rows. Lower = lower audit
# lag, more empty queries. 1s is conservative.
AUDIT_DRAIN_INTERVAL=1s

# How many outbox rows the drainer processes per iteration. Bounds the
# per-iteration lock window.
AUDIT_DRAIN_BATCH_SIZE=100

# Graceful shutdown deadline. Must exceed REQUEST_TIMEOUT so an
# in-flight long request can finish during shutdown. Phase 5 backlog
# item resolved here.
SHUTDOWN_TIMEOUT=30s
